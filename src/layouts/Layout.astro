---
import { getLangFromUrl, useTranslations, languages, defaultLang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{t('index.title')}</title>
	</head>
	<body>
		<nav>
			<div class="lang-switcher">
				{
					Object.entries(languages).map(([key, value]) => (
						<a href={`/${key}/`} class:list={{'active': key === lang}}>
							{value}
						</a>
					))
				}
			</div>
		</nav>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global> /* Klíčové slovo is:global zajistí, že styly platí pro celý web */
	:root {
		--bg-color: #000000;
		--text-color: #d1d1d1;
		--accent-color: #ffffff;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: var(--bg-color);
		color: var(--text-color);
		font-family: 'Inter', system-ui, sans-serif;
	}

	nav {
		background: #111;
		border-bottom: 1px solid #222;
		padding: 1rem 2rem;
	}

	.lang-switcher {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		gap: 1rem;
	}

	.lang-switcher a {
		color: #999;
		text-decoration: none;
		padding: 0.5rem 1rem;
		border-radius: 4px;
		transition: all 0.2s ease;
		border: 1px solid transparent;
	}

	.lang-switcher a:hover {
		color: #ccc;
		border-color: #555;
	}

	.lang-switcher a.active {
		color: #000;
		background: #fff;
		border-color: #fff;
	}

	main {
		max-width: 800px; /* Aby text nebyl přes celou šířku monitoru, blbě se to čte */
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	/* Základní oprava pro obrázky a mapy, aby nepřetékaly */
	img, iframe {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}

	a {
		color: var(--accent-color);
		text-decoration: underline;
	}
</style>

